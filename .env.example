# ==============================
# Telegram
# ==============================
BOT_TOKEN=your_telegram_bot_token_here

# ==============================
# PostgreSQL
# ==============================
# Either set DATABASE_URL directly...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instabot
# ...or the individual parts below are used only if DATABASE_URL is not set.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=instabot

# ==============================
# Binaries (leave as-is if they are on your PATH)
# ==============================
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ==============================
# Download behaviour
# ==============================
# Max simultaneous downloads per user
MAX_CONCURRENT_DOWNLOADS_PER_USER=2
# Max file size Telegram Bot API will accept (MB)
MAX_FILE_SIZE_MB=50
# Timeout for a single yt-dlp/ffmpeg process (ms)
PROCESS_TIMEOUT_MS=300000
# Where temporary files are written before being sent/cleaned up
TMP_DIR=./downloads/tmp

# ==============================
# Logging
# ==============================
LOG_LEVEL=info
LOG_DIR=./logs

# ==============================
# Forced subscription (optional)
# ==============================
# Comma-separated @usernames of channels users must subscribe to before using the bot.
# Leave empty to disable. The bot MUST be an admin in every listed channel.
REQUIRED_CHANNELS=

# ==============================
# Admin (optional)
# ==============================
# Comma-separated Telegram user IDs allowed to run /stats.
ADMIN_IDS=

# ==============================
# Music recognition (optional)
# ==============================
# API token from https://dashboard.audd.io — enables "send a voice/audio clip, get the song".
# Leave empty to disable the feature.
AUDD_API_KEY=

# ==============================
# Local Telegram Bot API server (optional)
# ==============================
# Raises the upload limit from Telegram's cloud-API cap (50MB) to 2000MB. Requires running
# your own bot-api server (see docker-compose's bot-api service) with credentials from
# https://my.telegram.org (API development tools).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# URL of the local server once it's running. Leave both empty to keep using Telegram's cloud API.
TELEGRAM_API_ROOT=

# ==============================
# YouTube cookies (optional, recommended for hosted deployments)
# ==============================
# YouTube often blocks datacenter IPs with "Sign in to confirm you're not a bot". Paste the
# full contents of a Netscape-format cookies.txt (exported from a real, logged-in YouTube
# session via a browser extension like "Get cookies.txt LOCALLY") as a single line — literal
# "\n" is unescaped automatically. Leave empty to skip; YouTube downloads are just less reliable.
YOUTUBE_COOKIES=
